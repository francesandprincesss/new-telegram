# Local Docker Compose values only. Use secret storage in deployed environments.
POSTGRES_USER=chat
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=chat
DATABASE_URL=postgres://chat:change-me-for-local-development@postgres:5432/chat?sslmode=disable

GRPC_ADDRESS=:50051
JWT_ISSUER=grpc-chat
JWT_TTL=24h
JWT_SECRET=replace-with-at-least-32-random-bytes
